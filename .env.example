# SQLite file used by Prisma for local dev
DATABASE_URL="file:./dev.db"

# Leave both unset to run in SIMULATE mode: bids apply instantly with no
# real payment, so you can try the whole flow with zero setup.
#
# Set both (from a Stripe test-mode account) to switch on real Checkout:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe success/cancel redirect URLs
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
