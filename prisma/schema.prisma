generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id @default(cuid())
  label     String   @unique
  category  String
  totalPaid Int
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bids      Bid[]
}

// One row per confirmed payment (the charge amount, not the listing's new
// running total) — lets "today" rankings be computed without a nightly
// reset job, just a createdAt filter.
model Bid {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  amount    Int
  createdAt DateTime @default(now())
}

model Visitor {
  id          String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}
