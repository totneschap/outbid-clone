generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id @default(cuid())
  label     String   @unique
  category  String
  totalPaid Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id          String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
}
